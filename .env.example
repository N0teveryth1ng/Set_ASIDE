# Copy to `.env` and fill in real values.
# Supabase project region was resolved as ap-southeast-1 (session pooler, port 5432).
# Get: Dashboard → Settings → Database (connection string) and → API Keys.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth (new key system — hides place your real values).
# Dashboard → Settings → API Keys → "Publishable and secret API keys" tab.
# Browser/client key  = publishable (sb_publishable_...) — low priv, RLS-aware.
# Server/admin key     = secret (sb_secret_...) — high priv. NOTE: accepted by
# /auth/v1/admin/* but it 401s on the PostgREST /rest/v1 root; use the DB
# password (DATABASE_URL) for SQL-level admin work.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."