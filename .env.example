# Copy to `.env` and fill in real values.
# URL of the Supabase Postgres instance. Placeholder only — replace with your project's connection string.
DATABASE_URL="postgresql://placeholder:placeholder@db.<your-supabase-project>.supabase.co:5432/postgres?schema=public"

# Supabase Auth (anon/public + JWT secret from the dashboard).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""